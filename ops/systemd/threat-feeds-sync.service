# =============================================================================
# threat-feeds-sync.service
#
# Copy to: /etc/systemd/system/threat-feeds-sync.service on the management host, and
# keep the reviewed copy here at ops/systemd/ in the repo.
#
# Paired with threat-feeds-sync.timer, which actually schedules it.
# =============================================================================

[Unit]
Description=Fetch threat-intel feeds and publish the aggregated blocklist
Documentation=https://github.com/Endicott-College-Infrastructure/threat-feeds
After=network-online.target
Wants=network-online.target

# A failed run is not automatically visible -- nobody watches journald by
# default, and this feed going stale for days would be silent otherwise. Point
# this at a real handler (email/Slack/an issue) before relying on this timer;
# see AGENTS.md section 8 for the current status of that handler.
#
# THIS DIRECTIVE MUST STAY IN [Unit]. OnFailure is a Unit option; systemd
# parses the file section by section and ignores it under [Service]. This
# exact mistake happened on an earlier capture-style job in this estate --
# accepted without complaint, logged nothing, and left the handler inert.
OnFailure=threat-feeds-sync-failure@%n.service

[Service]
Type=oneshot

# Own dedicated account, NOT github-run -- that account is the Actions
# runner (deploy.yml dispatch), a different job from this one. Matches how
# other scheduled capture-style tools in this estate are actually deployed:
# each scheduled job gets its own unprivileged account, with push access
# granted specifically to the one repo it needs. See ops/install.sh for
# account creation.
User=threat-feeds
Group=threat-feeds

# Gives the account a real, owned home directory outside /home -- see
# ProtectHome= below for why that matters. Also sets $STATE_DIRECTORY,
# unused directly by this tool but harmless.
StateDirectory=threat-feeds

ExecStart=/opt/scripts/threat_feeds_sync.sh

# Network I/O against five external hosts plus a gitleaks scan. If it wedges,
# let it die rather than overlap with the next timer firing.
TimeoutStartSec=10min

# Light hardening. This unit runs unattended every hour, forever.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# NOT `true`: other scheduled capture-style tools in this estate hit this
# live -- useradd's default home for a service account is still
# /home/$USER even with --no-create-home, and
# ProtectHome=true masks all of /home with EACCES, breaking anything that
# resolves $HOME (git's global config lookup, gitleaks) rather than merely
# making it read-only. The real fix applied here is at the ACCOUNT level
# (ops/install.sh requires --home-dir /var/lib/threat-feeds, outside the
# masked paths) -- `read-only` is kept as defense in depth, not a substitute
# for that fix, since it's untested whether read-only alone would have been
# enough on its own.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
